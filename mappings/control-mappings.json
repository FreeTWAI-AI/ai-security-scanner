  "entries": [
    {
      "engine_id": "prowler",
      "match_kind": "exact",
      "source_rule": "iam_customer_attached_policy_no_administrative_privileges",
      "controls": [
        "nist-pr-aa-05",
        "iso-5-18",
        "iso-8-2",
        "cis-aws-1-16"
      ],
      "rationale": "Evidence that an attached identity policy grants unrestricted administrative permissions is related to least privilege, entitlement review, and privileged access safeguards."
    },
    {
      "engine_id": "scoutsuite",
      "match_kind": "exact",
      "source_rule": "s3-bucket-world-policy-star",
      "controls": [
        "nist-pr-aa-05",
        "iso-5-15",
        "iso-5-23"
      ],
      "rationale": "Evidence that an object-storage resource permits public access is related to access policy, authorization review, and cloud service protection."
    },
    {
      "engine_id": "scoutsuite",
      "match_kind": "exact",
      "source_rule": "iam-password-policy-no-uppercase-required",
      "controls": [
        "nist-pr-aa-01",
        "iso-5-17"
      ],
      "rationale": "Evidence that the account password policy does not require an uppercase character is related to credential lifecycle management and to safeguarding authentication information."
    },
    {
      "engine_id": "scoutsuite",
      "match_kind": "exact",
      "source_rule": "iam-ec2-role-without-instances",
      "controls": [
        "nist-pr-aa-05",
        "iso-5-18"
      ],
      "rationale": "Evidence that a role assumable by the EC2 service is attached to no instance is related to least privilege and entitlement review; an unused entitlement stays usable until it is removed."
    },
    {
      "engine_id": "cloudsplaining",
      "match_kind": "exact",
      "source_rule": "PrivilegeEscalation",
      "controls": [
        "nist-pr-aa-05",
        "iso-5-18",
        "iso-8-2"
      ],
      "rationale": "Evidence of an identity privilege-escalation path is related to least privilege, entitlement review, and privileged access safeguards."
    },
    {
      "engine_id": "cloudsplaining",
      "match_kind": "exact",
      "source_rule": "CredentialsExposure",
      "controls": [
        "nist-pr-aa-01",
        "nist-pr-aa-05",
        "iso-5-17",
        "iso-8-2"
      ],
      "rationale": "Evidence that an identity policy permits actions returning credential material is related to credential lifecycle management, least privilege, authentication information safeguards, and privileged access safeguards."
    },
    {
      "engine_id": "cloudsplaining",
      "match_kind": "exact",
      "source_rule": "DataExfiltration",
      "controls": [
        "nist-pr-aa-05",
        "nist-pr-ds-01",
        "iso-5-15",
        "iso-5-18"
      ],
      "rationale": "Evidence that an identity policy permits actions that can read stored data out of the account is related to least privilege, protection of data at rest, access policy, and entitlement review."
    },
    {
      "engine_id": "cloudsplaining",
      "match_kind": "exact",
      "source_rule": "ResourceExposure",
      "controls": [
        "nist-pr-aa-05",
        "iso-5-15",
        "iso-5-18",
        "iso-5-23"
      ],
      "rationale": "Evidence that an identity policy permits actions that change who can reach a resource is related to least privilege, access policy, entitlement review, and cloud service security responsibilities."
    },
    {
      "engine_id": "cloudsplaining",
      "match_kind": "exact",
      "source_rule": "InfrastructureModification",
      "controls": [
        "nist-pr-aa-05",
        "iso-5-18",
        "iso-8-2"
      ],
      "rationale": "Evidence that an identity policy permits actions that alter account infrastructure is related to least privilege, entitlement review, and privileged access safeguards."
    },
    {
      "engine_id": "cloudsplaining",
      "match_kind": "exact",
      "source_rule": "ServiceWildcard",
      "controls": [
        "nist-pr-aa-05",
        "iso-5-18",
        "iso-8-2"
      ],
      "rationale": "Evidence that an identity policy grants every action in a service is related to least privilege, entitlement review, and privileged access safeguards; a wildcard also covers actions the account has never reviewed."
    },
    {
      "engine_id": "scubagear",
      "match_kind": "exact",
      "source_rule": "MS.AAD.1.1v1",
      "controls": [
        "nist-pr-aa-03",
        "iso-5-17"
      ],
      "rationale": "Evidence that legacy authentication is not blocked is related to enforcing appropriate authentication and protecting authentication information."
    },
    {
      "engine_id": "maester",
      "match_kind": "exact",
      "source_rule": "MT.1001",
      "controls": [
        "nist-pr-aa-03",
        "iso-5-17"
      ],
      "rationale": "Evidence that privileged identities lack phishing-resistant authentication is related to authentication enforcement and authentication information safeguards."
    },
    {
      "engine_id": "nuclei",
      "match_kind": "exact",
      "source_rule": "phpmyadmin-panel",
      "controls": [
        "nist-id-ra-01",
        "iso-8-8"
      ],
      "rationale": "Evidence of an exposed database administration interface is related to identifying, validating, recording, and handling technical vulnerabilities."
    },
    {
      "engine_id": "semgrep",
      "match_kind": "exact",
      "source_rule": "ai-security-scanner.python.dynamic-code-execution",
      "controls": [
        "nist-pr-ps-06",
        "iso-8-28",
        "iso-8-29",
        "aidefend-h-025-001",
        "aidefend-h-031-002",
        "owasp-llm-2025-05"
      ],
      "rationale": "Static-analysis evidence of dynamic code execution is related to secure development and pre-execution dangerous-construct checks. AIDEFEND's AI-generated-artifact coordinate applies when the selected code was generated or materially changed by AI."
    },
    {
      "engine_id": "semgrep",
      "match_kind": "exact",
      "source_rule": "ai-security-scanner.python.shell-true",
      "controls": [
        "nist-pr-ps-06",
        "iso-8-28",
        "iso-8-29",
        "aidefend-h-025-001",
        "aidefend-h-031-002",
        "owasp-llm-2025-05"
      ],
      "rationale": "Static-analysis evidence that Python code invokes an operating-system shell is related to secure development and pre-execution dangerous-construct checks. AIDEFEND's AI-generated-artifact coordinate applies when the selected code was generated or materially changed by AI."
    },
    {
      "engine_id": "semgrep",
      "match_kind": "exact",
      "source_rule": "ai-security-scanner.javascript.child-process-exec",
      "controls": [
        "nist-pr-ps-06",
        "iso-8-28",
        "iso-8-29",
        "aidefend-h-025-001",
        "aidefend-h-031-002",
        "owasp-llm-2025-05"
      ],
      "rationale": "Static-analysis evidence that JavaScript or TypeScript code invokes a command through a shell is related to secure development and pre-execution dangerous-construct checks. AIDEFEND's AI-generated-artifact coordinate applies when the selected code was generated or materially changed by AI."
    },
    {
      "engine_id": "semgrep",
      "match_kind": "exact",
      "source_rule": "ai-security-scanner.generic.private-key",
      "controls": [
        "nist-pr-aa-01",
        "iso-5-17",
        "aidefend-h-031-002",
        "owasp-llm-2025-02"
      ],
      "rationale": "Static-analysis evidence of private-key material in current project files is related to managing credentials and protecting authentication information. AIDEFEND's static-admission coordinate applies when the selected artifact was generated or materially changed by AI."
    },
    {
      "engine_id": "gitleaks",
      "match_kind": "exact",
      "source_rule": "generic-api-key",
      "controls": [
        "nist-pr-aa-01",
        "iso-5-17",
        "aidefend-h-031-002",
        "owasp-llm-2025-02"
      ],
      "rationale": "Evidence of a credential embedded in current project files is related to managing credentials and protecting authentication information. AIDEFEND's static-admission coordinate applies when the selected artifact was generated or materially changed by AI."
    },
    {
      "engine_id": "trufflehog",
      "match_kind": "prefix",
      "source_rule": "trufflehog:",
      "controls": [
        "nist-pr-aa-01",
        "iso-5-17",
        "aidefend-h-031-002",
        "owasp-llm-2025-02"
      ],
      "rationale": "Every TruffleHog result is a detected credential, so this reference covers the engine's whole detector surface rather than one detector. Evidence of a credential in source material is related to managing credentials and protecting authentication information. AIDEFEND's static-admission coordinate applies when the selected artifact was generated or materially changed by AI."
    },
    {
      "engine_id": "checkov",
      "match_kind": "exact",
      "source_rule": "CKV_AWS_18",
      "controls": [
        "nist-pr-ps-04",
        "iso-8-15",
        "aidefend-h-003-005"
      ],
      "rationale": "Infrastructure-as-code evidence that access logging is disabled is related to security-relevant audit records. AIDEFEND's IaC-scanning coordinate applies when the selected configuration provisions an AI system."
    },
    {
      "engine_id": "kics",
      "match_kind": "exact",
      "source_rule": "5fb49a69-8d46-4495-a2f8-9c8c622b2b6e",
      "controls": [
        "nist-pr-ds-01",
        "iso-8-24",
        "aidefend-h-003-005"
      ],
      "rationale": "Infrastructure-as-code evidence that server-side encryption is absent is related to protecting data at rest and using cryptographic safeguards. AIDEFEND's IaC-scanning coordinate applies when the selected configuration provisions an AI system."
    },
    {
      "engine_id": "trivy",
      "match_kind": "prefix",
      "source_rule": "CVE-",
      "controls": [
        "nist-id-ra-01",
        "iso-8-8",
        "aidefend-h-003-001",
        "aidefend-h-003-010",
        "owasp-2021-a06",
        "owasp-llm-2025-03"
      ],
      "rationale": "Evidence that an installed component is affected by a CVE is related to vulnerability handling. For an AI system, AIDEFEND separates build or deployment admission from the deployed-software remediation lifecycle; this reference does not decide which lifecycle state applies."
    },
    {
      "engine_id": "grype",
      "match_kind": "prefix",
      "source_rule": "CVE-",
      "controls": [
        "nist-id-ra-01",
        "iso-8-8",
        "aidefend-h-003-001",
        "aidefend-h-003-010",
        "owasp-2021-a06",
