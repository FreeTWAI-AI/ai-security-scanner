diff --git a/tests/config_only_test.py b/tests/config_only_test.py
new file mode 100644
index 0000000..b4c77b7
--- /dev/null
+++ b/tests/config_only_test.py
@@ -0,0 +1,258 @@
+import asyncio
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+import pytest
+
+from mcp_armor import __version__
+import mcp_armor.config_scan as config_scan
+
+
+REPOSITORY_ROOT = Path(__file__).parents[1]
+SOURCE_ROOT = REPOSITORY_ROOT / "src"
+
+
+def _environment() -> dict[str, str]:
+    return {
+        "LC_ALL": "C.UTF-8",
+        "PYTHONHASHSEED": "0",
+        "PYTHONPATH": str(SOURCE_ROOT),
+    }
+
+
+def _write_config(path: Path, server: dict) -> None:
+    path.write_text(json.dumps({"mcpServers": {"fixture": server}}), encoding="utf-8")
+
+
+def _run_config_only(tmp_path: Path, *config_files: Path, extra=()):
+    output = tmp_path / "report.json"
+    command = [
+        sys.executable,
+        "-m",
+        "mcp_armor.cli",
+        "scan",
+        "--config-only",
+        *[item for path in config_files for item in ("--config", str(path))],
+        "--output",
+        str(output),
+        *extra,
+    ]
+    completed = subprocess.run(
+        command,
+        cwd=tmp_path,
+        env=_environment(),
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    report = json.loads(output.read_text(encoding="utf-8")) if output.exists() else None
+    return completed, report
+
+
+def test_config_only_cli_emits_real_findings_without_live_dependencies(tmp_path):
+    fake_secret = "sk-" + "A" * 20 + "T3BlbkFJ" + "B" * 20
+    config = tmp_path / "mcp.json"
+    _write_config(
+        config,
+        {
+            "command": "python3",
+            "args": ["--allow-terminal"],
+            "permissions": ["terminal:exec"],
+            "env": {"FIXTURE_OPENAI_KEY": fake_secret},
+        },
+    )
+
+    completed, report = _run_config_only(tmp_path, config)
+
+    assert completed.returncode == 0, completed.stderr
+    assert report["schema_version"] == "1"
+    assert report["scanner_version"] == "1.0.2"
+    assert report["mode"] == "configuration_only"
+    assert report["complete"] is True
+    assert report["warnings"] == []
+    assert report["checks"] == [
+        {"id": "hardcoded_secrets", "status": "completed", "finding_count": 1},
+        {
+            "id": "excessive_tool_permissions",
+            "status": "completed",
+            "finding_count": 1,
+        },
+    ]
+    assert {finding["check_id"] for finding in report["findings"]} == {
+        "hardcoded_secrets",
+        "excessive_tool_permissions",
+    }
+    assert fake_secret not in json.dumps(report)
+    assert completed.stderr == ""
+    assert not (tmp_path / "logs").exists()
+
+
+def test_config_only_clean_result_has_exact_completed_ledger(tmp_path):
+    config = tmp_path / "safe.json"
+    _write_config(config, {"command": "safe-server", "args": []})
+
+    completed, report = _run_config_only(tmp_path, config)
+
+    assert completed.returncode == 0
+    assert report["input_count"] == 1
+    assert report["evaluated_input_count"] == 1
+    assert report["complete"] is True
+    assert report["findings"] == []
+    assert all(check["status"] == "completed" for check in report["checks"])
+
+
+def test_config_only_retains_valid_results_when_another_input_is_invalid(tmp_path):
+    valid = tmp_path / "valid.json"
+    invalid = tmp_path / "invalid.json"
+    _write_config(valid, {"command": "python", "args": []})
+    invalid.write_text("{", encoding="utf-8")
+
+    completed, report = _run_config_only(tmp_path, valid, invalid)
+
+    assert completed.returncode == 0
+    assert report["input_count"] == 2
+    assert report["evaluated_input_count"] == 1
+    assert report["complete"] is False
+    assert [warning["code"] for warning in report["warnings"]] == ["config_invalid"]
+    assert all(check["status"] == "completed" for check in report["checks"])
+    assert len(report["findings"]) == 1
+
+
+def test_config_only_writes_incomplete_report_and_fails_without_valid_input(tmp_path):
+    invalid = tmp_path / "invalid.json"
+    invalid.write_text("{", encoding="utf-8")
+
+    completed, report = _run_config_only(tmp_path, invalid)
+
+    assert completed.returncode == 1
+    assert report["complete"] is False
+    assert report["evaluated_input_count"] == 0
+    assert all(check["status"] == "not_run" for check in report["checks"])
+    assert report["findings"] == []
+
+
+def test_config_only_preserves_completed_findings_when_a_check_fails(
+    tmp_path, monkeypatch
+):
+    config = tmp_path / "risky.json"
+    _write_config(config, {"command": "python", "args": []})
+
+    async def failed_check(_scan_result, fail_on_error=False):
+        assert fail_on_error is True
+        raise RuntimeError("fixture check failure")
+
+    monkeypatch.setattr(
+        config_scan,
+        "CONFIGURATION_CHECKS",
+        (
+            (
+                "excessive_tool_permissions",
+                config_scan.scan_for_excessive_tool_permissions,
+            ),
+            ("fixture_failure", failed_check),
+        ),
+    )
+
+    report, evaluated = asyncio.run(
+        config_scan.scan_configuration_files([str(config)])
+    )
+
+    assert evaluated is True
+    assert report["complete"] is False
+    assert report["checks"] == [
+        {
+            "id": "excessive_tool_permissions",
+            "status": "completed",
+            "finding_count": 1,
+        },
+        {"id": "fixture_failure", "status": "failed", "finding_count": 0},
+    ]
+    assert len(report["findings"]) == 1
+    assert report["warnings"] == [
+        {
+            "code": "check_failed",
+            "message": "RuntimeError: fixture check failure",
+            "config_file": None,
+            "check_id": "fixture_failure",
+        }
+    ]
+
+
+def test_config_only_marks_unparseable_server_without_losing_checks(tmp_path):
+    config = tmp_path / "mixed.json"
+    config.write_text(
+        json.dumps(
+            {
+                "mcpServers": {
+                    "invalid": {"type": "unknown", "command": "safe-server"},
+                    "valid": {"command": "safe-server"},
+                }
+            }
+        ),
+        encoding="utf-8",
+    )
+
+    completed, report = _run_config_only(tmp_path, config)
+
+    assert completed.returncode == 0
+    assert report["complete"] is False
+    assert [warning["code"] for warning in report["warnings"]] == [
+        "server_config_invalid"
+    ]
+    assert all(check["status"] == "completed" for check in report["checks"])
+
+
+@pytest.mark.parametrize(
+    "extra, expected",
+    [
+        ((), "requires at least one --config"),
+        (("--baseline", "baseline.json"), "--baseline is not available"),
+        (("--report-type", "md"), "requires --report-type json"),
+    ],
+)
+def test_config_only_rejects_ambiguous_cli_combinations(tmp_path, extra, expected):
+    config_files = ()
+    if extra:
+        config = tmp_path / "safe.json"
+        _write_config(config, {"command": "safe-server"})
+        config_files = (config,)
+
+    completed, report = _run_config_only(tmp_path, *config_files, extra=extra)
+
+    assert completed.returncode == 1
+    assert expected in completed.stderr
+    assert report is None
+
+
+def test_config_only_imports_no_live_or_model_modules():
+    code = """
+import sys
+import mcp_armor.config_scan
+for name in ('fastmcp', 'transformers', 'torch'):
+    assert name not in sys.modules, name
+"""
+    completed = subprocess.run(
+        [sys.executable, "-c", code],
+        env=_environment(),
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    assert completed.returncode == 0, completed.stderr
+
+
+def test_model_dependencies_are_an_explicit_extra():
+    metadata = (REPOSITORY_ROOT / "pyproject.toml").read_text(encoding="utf-8")
+
+    base_dependencies, optional_dependencies = metadata.split(
+        "[project.optional-dependencies]", maxsplit=1
+    )
+    assert '"torch~=' not in base_dependencies
+    assert '"transformers~=' not in base_dependencies
+    assert 'prompt-injection = [' in optional_dependencies
+    assert '"transformers~=4.57.1"' in optional_dependencies
+    assert '"torch~=2.9.0"' in optional_dependencies
+    assert f'version = "{__version__}"' in metadata
