diff --git a/src/mcp_armor/config_scan.py b/src/mcp_armor/config_scan.py
new file mode 100644
index 0000000..a698135
--- /dev/null
+++ b/src/mcp_armor/config_scan.py
@@ -0,0 +1,218 @@
+"""Machine-readable, configuration-only MCP security scanning.
+
+This module deliberately imports neither the live MCP connector nor the
+model-backed prompt-injection checks. It exposes the two existing checks that
+operate only on selected configuration files and reports their completeness.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Awaitable, Callable
+from typing import Any
+
+from . import __version__
+from .config_validator import load_and_validate_config
+from .scan_checks.excessive_tool_permissions import (
+    scan_for_excessive_tool_permissions,
+)
+from .scan_checks.hardcoded_secrets import scan_for_hardcoded_secrets
+from .scanner import MCPConfigScanner
+from .security_utils import MCPServerInfo, ScanResult, SecurityIssue
+
+SCHEMA_VERSION = "1"
+MODE = "configuration_only"
+
+ConfigurationCheck = Callable[..., Awaitable[list[SecurityIssue]]]
+CONFIGURATION_CHECKS: tuple[tuple[str, ConfigurationCheck], ...] = (
+    ("hardcoded_secrets", scan_for_hardcoded_secrets),
+    ("excessive_tool_permissions", scan_for_excessive_tool_permissions),
+)
+
+
+def _warning(
+    code: str,
+    message: str,
+    *,
+    config_file: str | None = None,
+    check_id: str | None = None,
+) -> dict[str, Any]:
+    return {
+        "code": code,
+        "message": message,
+        "config_file": config_file,
+        "check_id": check_id,
+    }
+
+
+def _server_map(config: dict[str, Any]) -> Any:
+    if "mcpServers" in config:
+        return config["mcpServers"]
+    if "servers" in config:
+        return config["servers"]
+    return config
+
+
+def _parse_servers(
+    scanner: MCPConfigScanner,
+    config: dict[str, Any],
+    config_file: str,
+    warnings: list[dict[str, Any]],
+) -> list[MCPServerInfo]:
+    servers: list[MCPServerInfo] = []
+    entries = _server_map(config)
+    if not isinstance(entries, dict):
+        warnings.append(
+            _warning(
+                "config_invalid",
+                "MCP server collection was not an object",
+                config_file=config_file,
+            )
+        )
+        return servers
+
+    for server_name, server_config in entries.items():
+        if not isinstance(server_config, dict):
+            warnings.append(
+                _warning(
+                    "server_config_invalid",
+                    f"Server '{server_name}' was not a configuration object",
+                    config_file=config_file,
+                )
+            )
+            continue
+        try:
+            servers.append(
+                scanner.create_server_info(
+                    str(server_name),
+                    server_config,
+                    config_file,
+                    is_user_provided=True,
+                )
+            )
+        except Exception as error:
+            warnings.append(
+                _warning(
+                    "server_config_invalid",
+                    f"Server '{server_name}' could not be parsed: {error}",
+                    config_file=config_file,
+                )
+            )
+    return servers
+
+
+def _serialize_finding(check_id: str, issue: SecurityIssue) -> dict[str, Any]:
+    return {
+        "check_id": check_id,
+        "finding_type": issue.issue_type,
+        "severity": issue.severity.value,
+        "description": issue.description,
+        "recommendation": issue.recommendation,
+        "entity_type": issue.entity_type,
+        "affected_server": issue.affected_server,
+        "config_file": issue.config_file,
+        "affected_tool": issue.affected_tool,
+        "affected_resource": issue.affected_resource,
+        "affected_resource_uri": issue.affected_resource_uri,
+        "affected_entities": issue.affected_entities,
+    }
+
+
+async def scan_configuration_files(
+    config_files: list[str],
+) -> tuple[dict[str, Any], bool]:
+    """Scan exact files without server contact and return an output envelope.
+
+    The boolean indicates whether at least one input was readable and therefore
+    whether an exit-zero partial result can preserve completed findings.
+    """
+
+    exact_files = list(dict.fromkeys(config_files))
+    warnings: list[dict[str, Any]] = []
+    valid_files: list[str] = []
+    servers: list[MCPServerInfo] = []
+    scanner = MCPConfigScanner()
+
+    for config_file in exact_files:
+        config, validation_errors = load_and_validate_config(config_file)
+        if config is None:
+            message = "; ".join(validation_errors) or "Configuration could not be read"
+            warnings.append(
+                _warning("config_invalid", message, config_file=config_file)
+            )
+            continue
+
+        valid_files.append(config_file)
+        for message in validation_errors:
+            warnings.append(
+                _warning("config_invalid", message, config_file=config_file)
+            )
+        if isinstance(config, dict):
+            servers.extend(_parse_servers(scanner, config, config_file, warnings))
+        else:
+            warnings.append(
+                _warning(
+                    "config_invalid",
+                    "Configuration root was not an object",
+                    config_file=config_file,
+                )
+            )
+
+    scan_result = ScanResult(
+        servers=servers,
+        tools=[],
+        resources=[],
+        prompts=[],
+        resource_templates=[],
+        config_files=valid_files,
+    )
+
+    findings: list[dict[str, Any]] = []
+    checks: list[dict[str, Any]] = []
+    for check_id, check in CONFIGURATION_CHECKS:
+        if not valid_files:
+            checks.append(
+                {"id": check_id, "status": "not_run", "finding_count": 0}
+            )
+            continue
+
+        try:
+            check_findings = await check(scan_result, fail_on_error=True)
+            if not isinstance(check_findings, list):
+                raise TypeError("check did not return a finding list")
+            findings.extend(
+                _serialize_finding(check_id, issue) for issue in check_findings
+            )
+            checks.append(
+                {
+                    "id": check_id,
+                    "status": "completed",
+                    "finding_count": len(check_findings),
+                }
+            )
+        except Exception as error:
+            checks.append(
+                {"id": check_id, "status": "failed", "finding_count": 0}
+            )
+            warnings.append(
+                _warning(
+                    "check_failed",
+                    f"{type(error).__name__}: {error}",
+                    check_id=check_id,
+                )
+            )
+
+    complete = bool(valid_files) and not warnings and all(
+        check["status"] == "completed" for check in checks
+    )
+    envelope = {
+        "schema_version": SCHEMA_VERSION,
+        "scanner_version": __version__,
+        "mode": MODE,
+        "input_count": len(exact_files),
+        "evaluated_input_count": len(valid_files),
+        "complete": complete,
+        "warnings": warnings,
+        "checks": checks,
+        "findings": findings,
+    }
+    return envelope, bool(valid_files)
