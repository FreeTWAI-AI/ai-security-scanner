@@ -0,0 +1,51 @@
+package scanner
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/praetorian-inc/augustus/pkg/attempt"
+)
+
+type machineCountGenerator struct{}
+
+func (machineCountGenerator) Generate(context.Context, *attempt.Conversation, int) ([]attempt.Message, error) {
+	return []attempt.Message{attempt.NewAssistantMessage("synthetic")}, nil
+}
+func (machineCountGenerator) ClearHistory()       {}
+func (machineCountGenerator) Name() string        { return "test.Repeat" }
+func (machineCountGenerator) Description() string { return "synthetic count generator" }
+
+type machineCountProbe struct {
+	name     string
+	attempts []*attempt.Attempt
+	err      error
+}
+
+func (p machineCountProbe) Probe(context.Context, Generator) ([]*attempt.Attempt, error) {
+	return p.attempts, p.err
+}
+func (p machineCountProbe) Name() string { return p.name }
+
+func TestRunRecordsMachineCoverageCounts(t *testing.T) {
+	engine := New(Options{Concurrency: 1})
+	result := engine.Run(
+		context.Background(),
+		[]Prober{
+			machineCountProbe{name: "synthetic.Success", attempts: []*attempt.Attempt{{ID: "one"}}},
+			machineCountProbe{name: "synthetic.Failure", err: errors.New("synthetic probe failure")},
+		},
+		machineCountGenerator{},
+	)
+
+	if result.Total != 2 || result.Started != 2 || result.Completed != 2 {
+		t.Fatalf("total/started/completed = %d/%d/%d, want 2/2/2", result.Total, result.Started, result.Completed)
+	}
+	if result.Succeeded != 1 || result.Failed != 1 {
+		t.Fatalf("succeeded/failed = %d/%d, want 1/1", result.Succeeded, result.Failed)
+	}
+	if len(result.FailedProbeNames) != 1 || result.FailedProbeNames[0] != "synthetic.Failure" {
+		t.Fatalf("failed probe names = %#v", result.FailedProbeNames)
+	}
+}
