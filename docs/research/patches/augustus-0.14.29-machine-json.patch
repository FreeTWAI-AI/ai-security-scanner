diff --git a/pkg/results/machine.go b/pkg/results/machine.go
new file mode 100644
index 0000000..a40afc3
--- /dev/null
+++ b/pkg/results/machine.go
@@ -0,0 +1,179 @@
+package results
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"sort"
+
+	"github.com/praetorian-inc/augustus/pkg/attempt"
+	"github.com/praetorian-inc/augustus/pkg/harnesses"
+)
+
+const MachineSchemaVersion = "1"
+
+// MachineTarget is trusted invocation metadata. It identifies the one model
+// endpoint selected by the caller; it is never inferred from model output.
+type MachineTarget struct {
+	Generator string `json:"generator"`
+	Endpoint  string `json:"endpoint"`
+	Model     string `json:"model,omitempty"`
+}
+
+// MachinePlanEntry records exactly which local detectors were selected for a
+// probe. ExpectedAttempts is the probe's declared prompt count.
+type MachinePlanEntry struct {
+	Probe            string   `json:"probe"`
+	Detectors        []string `json:"detectors"`
+	ExpectedAttempts *int     `json:"expected_attempts"`
+}
+
+// MachineMetadata is supplied by trusted orchestration rather than target
+// content.
+type MachineMetadata struct {
+	ScannerVersion string             `json:"scanner_version"`
+	SourceRevision string             `json:"source_revision"`
+	RunID          string             `json:"run_id"`
+	Target         MachineTarget      `json:"target"`
+	Plan           []MachinePlanEntry `json:"plan"`
+}
+
+// MachineCounts is the explicit run ledger. The adapter does not derive any of
+// these values by counting whatever rows happened to survive output.
+type MachineCounts struct {
+	ExpectedProbes    int `json:"expected_probes"`
+	StartedProbes     int `json:"started_probes"`
+	CompletedProbes   int `json:"completed_probes"`
+	SucceededProbes   int `json:"succeeded_probes"`
+	FailedProbes      int `json:"failed_probes"`
+	ExpectedAttempts  int `json:"expected_attempts"`
+	ProducedAttempts  int `json:"produced_attempts"`
+	ProcessedAttempts int `json:"processed_attempts"`
+	EmittedAttempts   int `json:"emitted_attempts"`
+	NotTestedAttempts int `json:"not_tested_attempts"`
+	ErroredAttempts   int `json:"errored_attempts"`
+}
+
+// MachineReport is one terminal JSON document. The encoder returns an error
+// instead of leaving a partial stream that could be mistaken for success.
+type MachineReport struct {
+	SchemaVersion  string                      `json:"schema_version"`
+	ScannerVersion string                      `json:"scanner_version"`
+	SourceRevision string                      `json:"source_revision"`
+	RunID          string                      `json:"run_id"`
+	Target         MachineTarget               `json:"target"`
+	Plan           []MachinePlanEntry          `json:"plan"`
+	Counts         MachineCounts               `json:"counts"`
+	Complete       bool                        `json:"complete"`
+	Warnings       []harnesses.CoverageWarning `json:"warnings"`
+	Attempts       []AttemptResult             `json:"attempts"`
+}
+
+// NewMachineReport constructs a fail-closed terminal report. Count,
+// provenance, detector, and attempt shortfalls become structured warnings and
+// clear Complete without changing any upstream attempt verdict or score.
+func NewMachineReport(
+	metadata MachineMetadata,
+	coverage harnesses.RunCoverage,
+	attempts []*attempt.Attempt,
+) MachineReport {
+	attemptResults := ToAttemptResults(attempts)
+	warnings := make([]harnesses.CoverageWarning, len(coverage.Warnings))
+	copy(warnings, coverage.Warnings)
+	planExpectedAttempts := 0
+	planComplete := len(metadata.Plan) > 0
+	for _, entry := range metadata.Plan {
+		if entry.Probe == "" || len(entry.Detectors) == 0 || entry.ExpectedAttempts == nil {
+			planComplete = false
+			continue
+		}
+		planExpectedAttempts += *entry.ExpectedAttempts
+	}
+
+	notTested := 0
+	errored := 0
+	for _, a := range attempts {
+		if NotTested(a) {
+			notTested++
+		}
+		if IsErrored(a.Status) {
+			errored++
+		}
+	}
+
+	if metadata.ScannerVersion == "" || metadata.ScannerVersion == "dev" ||
+		metadata.SourceRevision == "" || metadata.SourceRevision == "unknown" || metadata.RunID == "" ||
+		metadata.Target.Generator == "" || metadata.Target.Endpoint == "" {
+		warnings = append(warnings, harnesses.CoverageWarning{Code: "provenance_incomplete"})
+	}
+	if metadata.Target.Generator != "test.Repeat" && metadata.Target.Model == "" {
+		warnings = append(warnings, harnesses.CoverageWarning{Code: "target_model_missing"})
+	}
+	if !planComplete {
+		warnings = append(warnings, harnesses.CoverageWarning{Code: "plan_incomplete"})
+	}
+	if !coverage.ExpectedAttemptsKnown || !planComplete {
+		warnings = append(warnings, harnesses.CoverageWarning{Code: "expected_attempt_count_unavailable"})
+	}
+	if coverage.ExpectedProbes != len(metadata.Plan) ||
+		coverage.StartedProbes != coverage.ExpectedProbes ||
+		coverage.CompletedProbes != coverage.ExpectedProbes ||
+		coverage.SucceededProbes != coverage.ExpectedProbes ||
+		coverage.FailedProbes != 0 ||
+		(coverage.ExpectedAttemptsKnown && coverage.ProducedAttempts != coverage.ExpectedAttempts) ||
+		(planComplete && planExpectedAttempts != coverage.ExpectedAttempts) ||
+		coverage.ProcessedAttempts != coverage.ProducedAttempts ||
+		len(attempts) != coverage.ProducedAttempts {
+		warnings = append(warnings, harnesses.CoverageWarning{Code: "count_mismatch"})
+	}
+	if notTested > 0 {
+		warnings = append(warnings, harnesses.CoverageWarning{Code: "attempt_not_tested"})
+	}
+	if errored > 0 {
+		warnings = append(warnings, harnesses.CoverageWarning{Code: "attempt_errored"})
+	}
+
+	sort.SliceStable(warnings, func(i, j int) bool {
+		left := warnings[i].Code + "\x00" + warnings[i].Probe + "\x00" + warnings[i].AttemptID + "\x00" + warnings[i].Detector
+		right := warnings[j].Code + "\x00" + warnings[j].Probe + "\x00" + warnings[j].AttemptID + "\x00" + warnings[j].Detector
+		return left < right
+	})
+
+	counts := MachineCounts{
+		ExpectedProbes:    coverage.ExpectedProbes,
+		StartedProbes:     coverage.StartedProbes,
+		CompletedProbes:   coverage.CompletedProbes,
+		SucceededProbes:   coverage.SucceededProbes,
+		FailedProbes:      coverage.FailedProbes,
+		ExpectedAttempts:  coverage.ExpectedAttempts,
+		ProducedAttempts:  coverage.ProducedAttempts,
+		ProcessedAttempts: coverage.ProcessedAttempts,
+		EmittedAttempts:   len(attemptResults),
+		NotTestedAttempts: notTested,
+		ErroredAttempts:   errored,
+	}
+
+	return MachineReport{
+		SchemaVersion:  MachineSchemaVersion,
+		ScannerVersion: metadata.ScannerVersion,
+		SourceRevision: metadata.SourceRevision,
+		RunID:          metadata.RunID,
+		Target:         metadata.Target,
+		Plan:           metadata.Plan,
+		Counts:         counts,
+		Complete:       len(warnings) == 0,
+		Warnings:       warnings,
+		Attempts:       attemptResults,
+	}
+}
+
+// WriteMachineJSON writes one complete machine document. Callers must treat an
+// error as a failed run; no partial byte sequence is admissible evidence.
+func WriteMachineJSON(w io.Writer, report MachineReport) error {
+	encoder := json.NewEncoder(w)
+	encoder.SetIndent("", "  ")
+	if err := encoder.Encode(report); err != nil {
+		return fmt.Errorf("failed to encode machine report: %w", err)
+	}
+	return nil
+}
