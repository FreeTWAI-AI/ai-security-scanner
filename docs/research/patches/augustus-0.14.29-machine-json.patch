diff --git a/pkg/harnesses/coverage.go b/pkg/harnesses/coverage.go
new file mode 100644
index 0000000..ce135e7
--- /dev/null
+++ b/pkg/harnesses/coverage.go
@@ -0,0 +1,40 @@
+package harnesses
+
+import (
+	"context"
+
+	"github.com/praetorian-inc/augustus/pkg/attempt"
+)
+
+// CoverageWarning is a bounded, machine-readable record of work that could
+// not be evaluated. It deliberately omits the underlying error text because
+// detector and target errors may contain model output or credentials.
+type CoverageWarning struct {
+	Code      string `json:"code"`
+	Probe     string `json:"probe,omitempty"`
+	AttemptID string `json:"attempt_id,omitempty"`
+	Detector  string `json:"detector,omitempty"`
+}
+
+// RunCoverage records the work ledger produced by a harness. ExpectedAttempts
+// is trustworthy only when ExpectedAttemptsKnown is true.
+type RunCoverage struct {
+	ExpectedProbes        int
+	StartedProbes         int
+	CompletedProbes       int
+	SucceededProbes       int
+	FailedProbes          int
+	ExpectedAttempts      int
+	ExpectedAttemptsKnown bool
+	ProducedAttempts      int
+	ProcessedAttempts     int
+	Warnings              []CoverageWarning
+}
+
+// RunEvaluator receives the attempt list together with the harness's coverage
+// ledger. Human evaluators retain the smaller Evaluator interface; machine
+// consumers opt into this interface so they never infer completeness from the
+// presence or absence of attempt rows.
+type RunEvaluator interface {
+	EvaluateRun(ctx context.Context, attempts []*attempt.Attempt, coverage RunCoverage) error
+}
