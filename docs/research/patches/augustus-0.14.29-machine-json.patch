@@ -0,0 +1,24 @@
+package results
+
+import (
+	"errors"
+	"testing"
+)
+
+type machineFailingWriter struct{}
+
+var errSyntheticWriteFailure = errors.New("synthetic write failure")
+
+func (machineFailingWriter) Write([]byte) (int, error) {
+	return 0, errSyntheticWriteFailure
+}
+
+func TestWriteMachineJSONReturnsWriteFailure(t *testing.T) {
+	err := WriteMachineJSON(machineFailingWriter{}, MachineReport{SchemaVersion: MachineSchemaVersion})
+	if err == nil {
+		t.Fatal("WriteMachineJSON() error = nil, want synthetic write failure")
+	}
+	if !errors.Is(err, errSyntheticWriteFailure) {
+		t.Fatalf("WriteMachineJSON() error = %q", err)
+	}
+}
