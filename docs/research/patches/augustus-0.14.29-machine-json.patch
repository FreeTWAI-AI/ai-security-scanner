+++ b/pkg/harnesses/detection_machine_test.go
@@ -0,0 +1,51 @@
+package harnesses
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/praetorian-inc/augustus/pkg/attempt"
+	"github.com/praetorian-inc/augustus/pkg/detectors"
+)
+
+type machineErrorDetector struct{}
+
+func (machineErrorDetector) Detect(context.Context, *attempt.Attempt) ([]float64, error) {
+	return nil, errors.New("synthetic detector failure")
+}
+
+func (machineErrorDetector) Name() string        { return "synthetic.FailsClosed" }
+func (machineErrorDetector) Description() string { return "synthetic detector failure" }
+
+func TestApplyDetectorsWithWarningsRecordsSkippedDetector(t *testing.T) {
+	a := attempt.New("synthetic prompt")
+	a.ID = "attempt-warning"
+	a.Probe = "synthetic.SingleTurn"
+	a.Detector = "synthetic.FailsClosed"
+
+	warnings, err := ApplyDetectorsWithWarnings(
+		context.Background(),
+		a,
+		[]detectors.Detector{machineErrorDetector{}},
+		SkipOnError,
+	)
+	if err != nil {
+		t.Fatalf("ApplyDetectorsWithWarnings() error = %v", err)
+	}
+	if len(warnings) != 1 {
+		t.Fatalf("warnings length = %d, want 1", len(warnings))
+	}
+	want := CoverageWarning{
+		Code:      "detector_failed",
+		Probe:     "synthetic.SingleTurn",
+		AttemptID: "attempt-warning",
+		Detector:  "synthetic.FailsClosed",
+	}
+	if warnings[0] != want {
+		t.Fatalf("warning = %#v, want %#v", warnings[0], want)
+	}
+	if a.Status != attempt.StatusComplete {
+		t.Fatalf("status = %q, want existing complete behavior", a.Status)
+	}
+}
