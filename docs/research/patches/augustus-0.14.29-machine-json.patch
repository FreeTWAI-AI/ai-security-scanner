@@ -0,0 +1,72 @@
+package main
+
+import (
+	"context"
+	"testing"
+
+	promptinjectdetector "github.com/praetorian-inc/augustus/internal/detectors/promptinject"
+	testgenerator "github.com/praetorian-inc/augustus/internal/generators/test"
+	_ "github.com/praetorian-inc/augustus/internal/probes/promptinject"
+	"github.com/praetorian-inc/augustus/pkg/detectors"
+	"github.com/praetorian-inc/augustus/pkg/probes"
+	"github.com/praetorian-inc/augustus/pkg/registry"
+	"github.com/praetorian-inc/augustus/pkg/types"
+)
+
+func TestHijackLongPromptMachinePlanHasExactAttemptCount(t *testing.T) {
+	probe, err := probes.Create("promptinject.HijackLongPrompt", registry.Config{})
+	if err != nil {
+		t.Fatalf("create probe: %v", err)
+	}
+	counter, ok := probe.(types.ExpectedAttemptCounter)
+	if !ok {
+		t.Fatal("promptinject.HijackLongPrompt does not implement ExpectedAttemptCounter")
+	}
+	if got := counter.ExpectedAttempts(); got != 15 {
+		t.Fatalf("ExpectedAttempts() = %d; want 15", got)
+	}
+
+	gen, err := testgenerator.NewRepeat(registry.Config{})
+	if err != nil {
+		t.Fatalf("create test.Repeat: %v", err)
+	}
+	attempts, err := probe.Probe(context.Background(), gen)
+	if err != nil {
+		t.Fatalf("run probe with test.Repeat: %v", err)
+	}
+	if len(attempts) != 15 {
+		t.Fatalf("test.Repeat attempts = %d; want 15", len(attempts))
+	}
+	for i, attempt := range attempts {
+		if len(attempt.Outputs) != 1 || attempt.Outputs[0] != attempt.Prompt {
+			t.Fatalf("attempt %d did not contain one local test.Repeat echo", i)
+		}
+	}
+
+	detector, err := promptinjectdetector.NewAttackRogueString(registry.Config{})
+	if err != nil {
+		t.Fatalf("create detector: %v", err)
+	}
+	plan, expected, known := buildMachinePlan(
+		[]probes.Prober{probe},
+		[]detectors.Detector{detector},
+		nil,
+		false,
+	)
+	if !known || expected != 15 {
+		t.Fatalf("expected attempts = %d, known = %t; want 15, true", expected, known)
+	}
+	if len(plan) != 1 {
+		t.Fatalf("machine plan entries = %d; want 1", len(plan))
+	}
+	entry := plan[0]
+	if entry.Probe != "promptinject.HijackLongPrompt" {
+		t.Fatalf("machine plan probe = %q", entry.Probe)
+	}
+	if entry.ExpectedAttempts == nil || *entry.ExpectedAttempts != 15 {
+		t.Fatalf("machine plan expected attempts = %v; want 15", entry.ExpectedAttempts)
+	}
+	if len(entry.Detectors) != 1 || entry.Detectors[0] != "promptinject.AttackRogueString" {
+		t.Fatalf("machine plan detectors = %#v", entry.Detectors)
+	}
+}
