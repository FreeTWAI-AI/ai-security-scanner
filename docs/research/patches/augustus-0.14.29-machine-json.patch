+}
+
+// ApplyDetectorsWithWarnings preserves ApplyDetectors' scoring behavior while
+// returning a bounded ledger for detectors skipped under SkipOnError. Machine
+// output uses that ledger to clear run completeness instead of treating a
+// logged detector failure as a clean result.
+func ApplyDetectorsWithWarnings(
+	ctx context.Context,
+	a *attempt.Attempt,
+	detectorList []detectors.Detector,
+	onError DetectorErrorBehavior,
+) ([]CoverageWarning, error) {
 	maxScore := 0.0
 	primaryDetector := ""
 	var primaryScores []float64
 	firstDetector := ""
 	var firstScores []float64
+	warnings := make([]CoverageWarning, 0)
 
 	for _, detector := range detectorList {
 		slog.Debug("running detector", "detector", detector.Name(), "probe", a.Probe)
@@ -135,10 +150,16 @@ func ApplyDetectors(
 					"detector", detector.Name(),
 					"probe", a.Probe,
 					"error", err)
+				warnings = append(warnings, CoverageWarning{
+					Code:      "detector_failed",
+					Probe:     a.Probe,
+					AttemptID: a.ID,
+					Detector:  detector.Name(),
+				})
 				continue
 			}
 			// FailOnError: return immediately
-			return fmt.Errorf("detector %s failed: %w", detector.Name(), err)
+			return warnings, fmt.Errorf("detector %s failed: %w", detector.Name(), err)
 		}
 
 		// Store detector results
@@ -198,5 +219,5 @@ func ApplyDetectors(
 		a.Complete()
 	}
 
-	return nil
