new file mode 100644
index 0000000..14ad10d
--- /dev/null
+++ b/internal/generators/test/machine_output_test.go
@@ -0,0 +1,184 @@
+package test
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/praetorian-inc/augustus/pkg/attempt"
+	"github.com/praetorian-inc/augustus/pkg/detectors"
+	"github.com/praetorian-inc/augustus/pkg/harnesses"
+	"github.com/praetorian-inc/augustus/pkg/results"
+)
+
+const machineSourceRevision = "f032fc6373aaa9983868282b31dc9c59503c78a2"
+
+type machineSyntheticDetector struct {
+	name  string
+	score float64
+	err   error
+}
+
+func (d machineSyntheticDetector) Detect(context.Context, *attempt.Attempt) ([]float64, error) {
+	if d.err != nil {
+		return nil, d.err
+	}
+	return []float64{d.score}, nil
+}
+
+func (d machineSyntheticDetector) Name() string        { return d.name }
+func (d machineSyntheticDetector) Description() string { return "synthetic machine-output detector" }
+
+func TestRepeatMachineOutputFixtures(t *testing.T) {
+	t.Run("complete", func(t *testing.T) {
+		a := repeatAttempt(t, "attempt-complete")
+		warnings, err := harnesses.ApplyDetectorsWithWarnings(
+			context.Background(),
+			a,
+			[]detectors.Detector{machineSyntheticDetector{name: "synthetic.Pass", score: 0.1}},
+			harnesses.SkipOnError,
+		)
+		if err != nil {
+			t.Fatalf("ApplyDetectorsWithWarnings() error = %v", err)
+		}
+		report := results.NewMachineReport(
+			machineMetadata("machine-complete", "synthetic.Pass", 1),
+			completeCoverage(warnings),
+			[]*attempt.Attempt{a},
+		)
+		if !report.Complete {
+			t.Fatalf("report.Complete = false, warnings = %#v", report.Warnings)
+		}
+		assertMachineFixture(t, "machine-complete.json", report)
+	})
+
+	t.Run("detector warning", func(t *testing.T) {
+		a := repeatAttempt(t, "attempt-warning")
+		detector := machineSyntheticDetector{
+			name: "synthetic.FailsClosed",
+			err:  errors.New("synthetic detector failure"),
+		}
+		a.Detector = detector.Name()
+		warnings, err := harnesses.ApplyDetectorsWithWarnings(
+			context.Background(),
+			a,
+			[]detectors.Detector{detector},
+			harnesses.SkipOnError,
+		)
+		if err != nil {
+			t.Fatalf("ApplyDetectorsWithWarnings() error = %v", err)
+		}
+		report := results.NewMachineReport(
+			machineMetadata("machine-detector-warning", detector.Name(), 1),
+			completeCoverage(warnings),
+			[]*attempt.Attempt{a},
+		)
+		if report.Complete {
+			t.Fatal("report.Complete = true after detector warning")
+		}
+		assertMachineFixture(t, "machine-detector-warning.json", report)
+	})
+
+	t.Run("count mismatch", func(t *testing.T) {
+		a := repeatAttempt(t, "attempt-count-mismatch")
+		detector := machineSyntheticDetector{name: "synthetic.Pass", score: 0.1}
+		warnings, err := harnesses.ApplyDetectorsWithWarnings(
+			context.Background(),
+			a,
+			[]detectors.Detector{detector},
+			harnesses.SkipOnError,
+		)
+		if err != nil {
+			t.Fatalf("ApplyDetectorsWithWarnings() error = %v", err)
+		}
+		metadata := machineMetadata("machine-count-mismatch", detector.Name(), 1)
+		one := 1
+		metadata.Plan = append(metadata.Plan, results.MachinePlanEntry{
+			Probe:            "synthetic.Missing",
+			Detectors:        []string{detector.Name()},
+			ExpectedAttempts: &one,
+		})
+		coverage := completeCoverage(warnings)
+		coverage.ExpectedProbes = 2
+		coverage.ExpectedAttempts = 2
+		report := results.NewMachineReport(metadata, coverage, []*attempt.Attempt{a})
+		if report.Complete {
+			t.Fatal("report.Complete = true after count mismatch")
+		}
+		assertMachineFixture(t, "machine-count-mismatch.json", report)
+	})
+}
+
+func repeatAttempt(t *testing.T, id string) *attempt.Attempt {
+	t.Helper()
+	gen, err := NewRepeat(nil)
+	if err != nil {
+		t.Fatalf("NewRepeat() error = %v", err)
+	}
+	conversation := attempt.NewConversation()
+	conversation.AddPrompt("SYNTHETIC AUGUSTUS REPEAT INPUT")
+	messages, err := gen.Generate(context.Background(), conversation, 1)
+	if err != nil {
+		t.Fatalf("test.Repeat Generate() error = %v", err)
+	}
+	if len(messages) != 1 {
+		t.Fatalf("test.Repeat messages = %d, want 1", len(messages))
+	}
+	a := attempt.New("SYNTHETIC AUGUSTUS REPEAT INPUT")
+	a.ID = id
+	a.Probe = "synthetic.SingleTurn"
+	a.Detector = "synthetic.Pass"
+	a.Generator = gen.Name()
+	a.Timestamp = time.Date(2026, time.September, 13, 12, 0, 0, 0, time.UTC)
+	a.AddOutput(messages[0].Content)
+	return a
+}
+
+func machineMetadata(runID, detector string, expectedAttempts int) results.MachineMetadata {
+	return results.MachineMetadata{
+		ScannerVersion: "v0.14.29",
+		SourceRevision: machineSourceRevision,
+		RunID:          runID,
+		Target: results.MachineTarget{
+			Generator: "test.Repeat",
+			Endpoint:  "local://test-repeat",
+		},
+		Plan: []results.MachinePlanEntry{{
+			Probe:            "synthetic.SingleTurn",
+			Detectors:        []string{detector},
+			ExpectedAttempts: &expectedAttempts,
+		}},
+	}
+}
+
+func completeCoverage(warnings []harnesses.CoverageWarning) harnesses.RunCoverage {
+	return harnesses.RunCoverage{
+		ExpectedProbes:        1,
+		StartedProbes:         1,
+		CompletedProbes:       1,
+		SucceededProbes:       1,
+		ExpectedAttempts:      1,
+		ExpectedAttemptsKnown: true,
+		ProducedAttempts:      1,
+		ProcessedAttempts:     1,
+		Warnings:              warnings,
+	}
+}
+
+func assertMachineFixture(t *testing.T, name string, report results.MachineReport) {
+	t.Helper()
+	var got bytes.Buffer
+	if err := results.WriteMachineJSON(&got, report); err != nil {
+		t.Fatalf("WriteMachineJSON() error = %v", err)
+	}
+	want, err := os.ReadFile("testdata/" + name)
+	if err != nil {
+		t.Fatalf("ReadFile(%s) error = %v", name, err)
+	}
+	if !bytes.Equal(got.Bytes(), want) {
+		t.Fatalf("machine fixture %s changed\n--- got ---\n%s\n--- want ---\n%s", name, got.Bytes(), want)
+	}
+}
