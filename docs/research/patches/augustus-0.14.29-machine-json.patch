diff --git a/cmd/augustus/machine.go b/cmd/augustus/machine.go
new file mode 100644
index 0000000..3bb8214
--- /dev/null
+++ b/cmd/augustus/machine.go
@@ -0,0 +1,132 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"io"
+
+	"github.com/praetorian-inc/augustus/pkg/attempt"
+	"github.com/praetorian-inc/augustus/pkg/detectors"
+	"github.com/praetorian-inc/augustus/pkg/harnesses"
+	"github.com/praetorian-inc/augustus/pkg/probes"
+	"github.com/praetorian-inc/augustus/pkg/results"
+	"github.com/praetorian-inc/augustus/pkg/types"
+)
+
+// machineEvaluator emits one terminal document after the harness has supplied
+// its coverage ledger. It intentionally cannot operate through Evaluate alone.
+type machineEvaluator struct {
+	writer   io.Writer
+	metadata results.MachineMetadata
+}
+
+func (m *machineEvaluator) Evaluate(context.Context, []*attempt.Attempt) error {
+	return errors.New("machine evaluator requires a run coverage ledger")
+}
+
+func (m *machineEvaluator) EvaluateRun(
+	_ context.Context,
+	attempts []*attempt.Attempt,
+	coverage harnesses.RunCoverage,
+) error {
+	report := results.NewMachineReport(m.metadata, coverage, attempts)
+	return results.WriteMachineJSON(m.writer, report)
+}
+
+// configureMachineEvaluator freezes trusted invocation metadata and the exact
+// selected detector plan before any probe is dispatched.
+func configureMachineEvaluator(
+	eval harnesses.Evaluator,
+	scannerVersion string,
+	revision string,
+	runID string,
+	generator string,
+	endpoint string,
+	model string,
+	probeList []probes.Prober,
+	detectorList []detectors.Detector,
+	overrides map[string][]detectors.Detector,
+	detectorsExplicit bool,
+) (expectedAttempts int, expectedAttemptsKnown bool, err error) {
+	machine, ok := eval.(*machineEvaluator)
+	if !ok {
+		total, known := machineExpectedAttempts(probeList)
+		return total, known, nil
+	}
+
+	plan, expectedAttempts, expectedAttemptsKnown := buildMachinePlan(
+		probeList,
+		detectorList,
+		overrides,
+		detectorsExplicit,
+	)
+	machine.metadata = results.MachineMetadata{
+		ScannerVersion: scannerVersion,
+		SourceRevision: revision,
+		RunID:          runID,
+		Target: results.MachineTarget{
+			Generator: generator,
+			Endpoint:  endpoint,
+			Model:     model,
+		},
+		Plan: plan,
+	}
+	return expectedAttempts, expectedAttemptsKnown, nil
+}
+
+func buildMachinePlan(
+	probeList []probes.Prober,
+	detectorList []detectors.Detector,
+	overrides map[string][]detectors.Detector,
+	detectorsExplicit bool,
+) ([]results.MachinePlanEntry, int, bool) {
+	plan := make([]results.MachinePlanEntry, 0, len(probeList))
+	total, known := machineExpectedAttempts(probeList)
+
+	for _, probe := range probeList {
+		primary := ""
+		var expected *int
+		if metadata, ok := probe.(types.ProbeMetadata); ok {
+			primary = metadata.GetPrimaryDetector()
+		}
+		if counter, ok := probe.(types.ExpectedAttemptCounter); ok {
+			count := counter.ExpectedAttempts()
+			if count > 0 {
+				expected = &count
+			}
+		}
+		selected := harnesses.SelectProbeDetectors(
+			&attempt.Attempt{Probe: probe.Name(), Detector: primary},
+			detectorList,
+			overrides,
+			detectorsExplicit,
+		)
+		detectorNames := make([]string, 0, len(selected))
+		for _, detector := range selected {
+			detectorNames = append(detectorNames, detector.Name())
+		}
+		plan = append(plan, results.MachinePlanEntry{
+			Probe:            probe.Name(),
+			Detectors:        detectorNames,
+			ExpectedAttempts: expected,
+		})
+	}
+
+	return plan, total, known
+}
+
+func machineExpectedAttempts(probeList []probes.Prober) (int, bool) {
+	total := 0
+	for _, probe := range probeList {
+		counter, ok := probe.(types.ExpectedAttemptCounter)
+		if !ok {
+			return 0, false
+		}
+		expected := counter.ExpectedAttempts()
+		if expected <= 0 {
+			return 0, false
+		}
+		total += expected
+	}
+	return total, true
+}
