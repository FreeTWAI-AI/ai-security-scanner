+		if s.MachineRunID == "" {
+			return fmt.Errorf("--machine-run-id is required with --format machine-json")
+		}
+		if s.MachineEndpoint == "" {
+			return fmt.Errorf("--machine-endpoint is required with --format machine-json")
+		}
+		if s.Output != "" || s.HTML != "" {
+			return fmt.Errorf("--format machine-json cannot be combined with --output or --html")
+		}
+		if len(s.Probe) == 0 || s.ProbesGlob != "" || s.All || len(s.Recon) != 0 {
+			return fmt.Errorf("--format machine-json requires explicit --probe values and rejects globs, --all, and recon")
+		}
+		if s.ConfigFile != "" || s.Config != "" || s.Profile != "" {
+			return fmt.Errorf("--format machine-json rejects argv and file configuration; use a typed isolated launcher")
+		}
+		if len(s.Buff) != 0 || s.BuffsGlob != "" || s.Setup != "" || s.Prepare != "" || s.Cleanup != "" {
+			return fmt.Errorf("--format machine-json rejects buffs and runtime hooks")
+		}
+		if s.DetectorsGlob != "" || len(s.RefusalPattern) != 0 {
+			return fmt.Errorf("--format machine-json rejects detector globs and runtime detector tuning")
+		}
+		if s.Harness != "probewise.Probewise" {
+			return fmt.Errorf("--format machine-json requires the probewise.Probewise harness")
+		}
+	}
+	if s.Format != "machine-json" && (s.MachineRunID != "" || s.MachineEndpoint != "") {
+		return fmt.Errorf("--machine-run-id and --machine-endpoint require --format machine-json")
+	}
+
 	return nil
 }
 
