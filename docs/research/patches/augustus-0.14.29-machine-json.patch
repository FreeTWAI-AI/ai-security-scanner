+	_ context.Context,
+	_ []*attempt.Attempt,
+	coverage harnesses.RunCoverage,
+) error {
+	e.called = true
+	e.coverage = coverage
+	return nil
+}
+
+func TestRunEvaluatorReceivesZeroAttemptCoverage(t *testing.T) {
+	eval := &machineCoverageEvaluator{}
+	h := New()
+	h.expectedAttempts = 1
+	h.expectedAttemptsKnown = true
+	err := h.Run(
+		context.Background(),
+		machineUnusedGenerator{},
+		[]probes.Prober{machineEmptyProbe{}},
+		[]detectors.Detector{machineUnusedDetector{}},
+		eval,
+	)
+	if err != nil {
+		t.Fatalf("Run() error = %v", err)
+	}
+	if !eval.called {
+		t.Fatal("EvaluateRun() was not called for zero attempts")
+	}
+	if eval.coverage.ExpectedAttempts != 1 || eval.coverage.ProducedAttempts != 0 {
+		t.Fatalf("coverage = %#v", eval.coverage)
+	}
+}
+
+var _ generators.Generator = machineUnusedGenerator{}
