+package main
+
+import (
+	"context"
+	"testing"
+
+	"github.com/praetorian-inc/augustus/pkg/attempt"
+	"github.com/praetorian-inc/augustus/pkg/detectors"
+	"github.com/praetorian-inc/augustus/pkg/probes"
+)
+
+type machinePlanDetector struct{}
+
+func (machinePlanDetector) Detect(context.Context, *attempt.Attempt) ([]float64, error) {
+	return []float64{0}, nil
+}
+func (machinePlanDetector) Name() string        { return "synthetic.Plan" }
+func (machinePlanDetector) Description() string { return "synthetic plan detector" }
+
+func TestBuildMachinePlanUsesExplicitAttemptContract(t *testing.T) {
+	probe := probes.NewSimpleProbe(
+		"synthetic.Static",
+		"synthetic goal",
+		"synthetic.Plan",
+		"synthetic static probe",
+		[]string{"one", "two"},
+	)
+	plan, expected, known := buildMachinePlan(
+		[]probes.Prober{probe},
+		[]detectors.Detector{machinePlanDetector{}},
+		nil,
+		false,
+	)
+	if !known || expected != 2 {
+		t.Fatalf("expected attempts = %d, known = %t; want 2, true", expected, known)
+	}
+	if len(plan) != 1 || plan[0].ExpectedAttempts == nil || *plan[0].ExpectedAttempts != 2 {
+		t.Fatalf("plan = %#v", plan)
+	}
+	if len(plan[0].Detectors) != 1 || plan[0].Detectors[0] != "synthetic.Plan" {
+		t.Fatalf("plan detectors = %#v", plan[0].Detectors)
+	}
+}
