--- a/agentic_radar/graph.py
+++ b/agentic_radar/graph.py
@@ -72,3 +72,11 @@ class GraphDefinition(BaseModel):
     edges: List[EdgeDefinition]
     agents: List[Agent] = Field(default_factory=list)
     tools: List[NodeDefinition] = Field(default_factory=list)
+
+
+class GraphExport(BaseModel):
+    schema_version: Literal["1"] = "1"
+    scanner_version: str
+    framework: str
+    status: Literal["workflow_found", "no_supported_workflow"]
+    graph: GraphDefinition
diff --git a/tests/graph_json_export_test.py b/tests/graph_json_export_test.py
new file mode 100644
index 0000000..69e8b00
--- /dev/null
+++ b/tests/graph_json_export_test.py
@@ -0,0 +1,196 @@
+import json
+
+import pytest
+from typer.testing import CliRunner
+
+import agentic_radar.analysis.openai_agents.analyze as openai_agents_analyze
+import agentic_radar.cli as cli
+from agentic_radar.analysis.openai_agents import OpenAIAgentsAnalyzer
+from agentic_radar.graph import (
+    EdgeDefinition,
+    GraphDefinition,
+    NodeDefinition,
+    NodeType,
+)
+
+runner = CliRunner()
+
+
+class StaticAnalyzer:
+    def __init__(self, graph: GraphDefinition):
+        self.graph = graph
+
+    def analyze(self, _root_directory: str) -> GraphDefinition:
+        return self.graph.model_copy(deep=True)
+
+
+def workflow_graph() -> GraphDefinition:
+    return GraphDefinition(
+        name="fixture",
+        nodes=[
+            NodeDefinition(type=NodeType.BASIC, name="START"),
+            NodeDefinition(type=NodeType.AGENT, name="assistant"),
+            NodeDefinition(type=NodeType.BASIC, name="END"),
+        ],
+        edges=[
+            EdgeDefinition(start="START", end="assistant"),
+            EdgeDefinition(start="assistant", end="END"),
+        ],
+    )
+
+
+@pytest.mark.parametrize(
+    ("framework", "factory_name"),
+    [
+        ("langgraph", "LangGraphAnalyzer"),
+        ("crewai", "CrewAIAnalyzer"),
+        ("n8n", "N8nAnalyzer"),
+        ("openai-agents", "OpenAIAgentsAnalyzer"),
+        ("autogen", "AutogenAgentChatAnalyzer"),
+    ],
+)
+def test_json_export_has_a_versioned_envelope_for_every_framework(
+    monkeypatch, tmp_path, framework, factory_name
+):
+    factory_calls = []
+
+    def analyzer_factory(*args, **kwargs):
+        factory_calls.append((args, kwargs))
+        return StaticAnalyzer(workflow_graph())
+
+    monkeypatch.setattr(cli, factory_name, analyzer_factory)
+    monkeypatch.setattr(
+        cli,
+        "map_vulnerabilities",
+        lambda _graph: pytest.fail("JSON export must bypass vulnerability mapping"),
+    )
+    requested_output = tmp_path / "report.html"
+
+    result = runner.invoke(
+        cli.app,
+        [
+            "scan",
+            framework,
+            "--input-dir",
+            str(tmp_path),
+            "--output-file",
+            str(requested_output),
+            "--export-graph-json",
+        ],
+    )
+
+    assert result.exit_code == 0, result.stdout
+    exported_output = tmp_path / "report.json"
+    payload = json.loads(exported_output.read_text(encoding="utf-8"))
+    assert payload["schema_version"] == "1"
+    assert payload["scanner_version"] == cli.__version__
+    assert payload["framework"] == framework
+    assert payload["status"] == "workflow_found"
+    assert payload["graph"]["name"] == "fixture"
+    assert payload["graph"]["nodes"][1]["node_type"] == "agent"
+    if framework == "openai-agents":
+        assert factory_calls == [((), {"assess_vulnerabilities": False})]
+    else:
+        assert factory_calls == [((), {})]
+
+
+def test_json_export_reports_no_supported_workflow_as_data(monkeypatch, tmp_path):
+    empty_graph = GraphDefinition(
+        name="fixture",
+        nodes=[
+            NodeDefinition(type=NodeType.BASIC, name="START"),
+            NodeDefinition(type=NodeType.BASIC, name="END"),
+        ],
+        edges=[],
+    )
+    monkeypatch.setattr(cli, "LangGraphAnalyzer", lambda: StaticAnalyzer(empty_graph))
+    requested_output = tmp_path / "empty.html"
+
+    result = runner.invoke(
+        cli.app,
+        [
+            "scan",
+            "langgraph",
+            "--input-dir",
+            str(tmp_path),
+            "--output-file",
+            str(requested_output),
+            "--export-graph-json",
+        ],
+    )
+
+    assert result.exit_code == 0, result.stdout
+    payload = json.loads((tmp_path / "empty.json").read_text(encoding="utf-8"))
+    assert payload["status"] == "no_supported_workflow"
+    assert payload["graph"]["nodes"] == [
+        {
+            "node_type": "basic",
+            "name": "START",
+            "description": None,
+            "label": None,
+            "category": None,
+            "vulnerabilities": [],
+        },
+        {
+            "node_type": "basic",
+            "name": "END",
+            "description": None,
+            "label": None,
+            "category": None,
+            "vulnerabilities": [],
+        },
+    ]
+
+
+def test_html_output_keeps_the_existing_no_workflow_failure(monkeypatch, tmp_path):
+    empty_graph = GraphDefinition(name="fixture", nodes=[], edges=[])
+    monkeypatch.setattr(cli, "LangGraphAnalyzer", lambda: StaticAnalyzer(empty_graph))
+    output = tmp_path / "empty.html"
+
+    result = runner.invoke(
+        cli.app,
+        [
+            "scan",
+            "langgraph",
+            "--input-dir",
+            str(tmp_path),
+            "--output-file",
+            str(output),
+        ],
+    )
+
+    assert result.exit_code == 1
+    assert "didn't find any agentic workflow" in result.stdout
+    assert not output.exists()
+
+
+def test_openai_agents_static_analysis_can_skip_hosted_assessment(
+    monkeypatch, tmp_path
+):
+    monkeypatch.setattr(
+        openai_agents_analyze, "collect_tool_assignments", lambda _root: {}
+    )
+    monkeypatch.setattr(openai_agents_analyze, "load_predefined_tools", lambda: {})
+    monkeypatch.setattr(openai_agents_analyze, "collect_mcp_servers", lambda _root: {})
+    monkeypatch.setattr(
+        openai_agents_analyze,
+        "collect_agent_assignments",
+        lambda **_kwargs: {},
+    )
+    monkeypatch.setattr(
+        openai_agents_analyze,
+        "collect_guardrails",
+        lambda _root, _agents: {},
+    )
+    monkeypatch.setattr(openai_agents_analyze, "load_tool_categories", lambda: {})
+    monkeypatch.setattr(
+        openai_agents_analyze,
+        "get_agent_vulnerabilities",
+        lambda _agents, _guardrails: pytest.fail(
+            "static graph export must not initialize hosted assessment"
+        ),
+    )
+
+    graph = OpenAIAgentsAnalyzer(assess_vulnerabilities=False).analyze(str(tmp_path))
+
+    assert [node.name for node in graph.nodes] == ["start", "end"]
