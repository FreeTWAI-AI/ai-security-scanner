@@ -194,6 +205,25 @@ def analyze_and_generate_report(
     print(f"Report {output_file} generated")
 
 
+def export_graph(
+    graph: AnalyzedGraphDefinition,
+    framework: str,
+    output_file: str,
+    status: Literal["workflow_found", "no_supported_workflow"],
+):
+    output_file = output_file.replace(".html", ".json")
+    export = GraphExport(
+        scanner_version=__version__,
+        framework=framework,
+        status=status,
+        graph=graph,
+    )
+    with open(output_file, "w", encoding="utf-8") as f:
+        f.write(export.model_dump_json(indent=2))
+        f.write("\n")
+    print(f"Graph exported to {output_file}")
+
+
 @app.command(
     "test",
     help="Test agents in an agentic workflow for various vulnerabilities. Requires OPENAI_API_KEY or AZURE_OPENAI_API_KEY set as an environment variable.",
diff --git a/agentic_radar/graph.py b/agentic_radar/graph.py
