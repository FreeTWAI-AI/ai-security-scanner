{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-security-scanner:research:augustus-preflight:1",
  "title": "Augustus research-only typed preflight exchange",
  "description": "Pure-data contract for fail-closed research preflight. It defines no successful or dispatchable output and grants no authority to start a process or contact a target.",
  "oneOf": [
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/output"
    }
  ],
  "$defs": {
