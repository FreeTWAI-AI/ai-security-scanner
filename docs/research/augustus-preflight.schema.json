      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_sha256",
        "enforcement_matrix_sha256",
        "rejection_vectors_sha256"
      ],
      "properties": {
        "profile_id": {
          "const": "augustus-openai-promptinject-v1"
        },
        "profile_sha256": {
          "const": "9dedd3695cd38575ba4137754803e50114c5a0f868a0f71ce5fd6305377e55b4"
        },
        "enforcement_matrix_sha256": {
          "const": "cd212569b48ad8186df0924cf0c86b2cbcac9bb7cb9a1bd71e1faed8a85240df"
        },
        "rejection_vectors_sha256": {
          "const": "3376e1757f658acbb13863584e105acc043192997ce3c02e71a73c174bedbab7"
        }
      }
    },
    "rule_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pre_contact_order",
        "rule_id",
        "state",
        "rejection_condition_indices"
      ],
      "properties": {
        "pre_contact_order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14
        },
        "rule_id": {
          "type": "string"
        },
        "state": {
          "enum": [
            "verified",
            "rejected",
            "unverified"
          ]
        },
        "rejection_condition_indices": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "const": "verified"
              }
            }
          },
          "then": {
            "properties": {
              "rejection_condition_indices": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "rejection_condition_indices": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
